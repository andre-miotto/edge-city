{
  "name": "edge-city",
  "version": "2.0.0",
  "private": true,
  "description": "Edge City — fábrica 3D interativa da Solução Linha 1 com WEGnology Edge Suite (WES), robôs, logística WMR e IA via MCP.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p .",
    "lint": "eslint src tests scripts tools",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.mjs\" \"tools/**/*.mjs\" index.html",
    "check": "npm run typecheck && npm run lint && npm run test:unit",
    "test:unit": "vitest run",
    "test": "npm run build && node tests/run-all.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "test:routes": "node tests/routes.mjs",
    "test:camera": "node tests/camera.mjs",
    "test:visual": "node tests/visual.mjs",
    "shots": "node tests/screenshots.mjs",
    "cad": "node tools/cad/build.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "meshoptimizer": "1.3.0",
    "pixelmatch": "7.2.0",
    "playwright": "1.63.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=20.19"
  }
}
